      {
        "chemin": [],
        "selecteur": ":root",
        "declarations": {
          "--marque-encre": "#051C2C",
          "--marque-navy": "#042A76",
          "--marque-action": "#2251FF",
          "--marque-action-survol": "#1B44DB",
          "--marque-action-clair": "#5B7BFF",
          "--marque-blanc": "#FFFFFF"
        }
      }
    ],

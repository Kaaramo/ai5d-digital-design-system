        "chemin": [],
        "selecteur": "[data-densite='compact']",
        "declarations": {
          "--rythme-section": "32px",
          "--padding-carte": "16px",
          "--hauteur-controle": "40px",
          "--ligne-liste": "40px",
          "--interligne-corps": "1.45",

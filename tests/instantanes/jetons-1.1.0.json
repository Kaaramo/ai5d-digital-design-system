    "noyau/paliers.css": [
      {
        "chemin": [],
        "selecteur": ":root",
        "declarations": {
          "--marge-page": "16px",
          "--zone-sure-basse": "env(safe-area-inset-bottom, 0px)",
          "--zone-sure-haute": "env(safe-area-inset-top, 0px)",
          "--zone-sure-gauche": "env(safe-area-inset-left, 0px)",
          "--zone-sure-droite": "env(safe-area-inset-right, 0px)",
          "--hauteur-entete": "56px",
          "--hauteur-barre-onglets": "56px",
          "--reserve-barre": "0px"
        }
      },
      {
        "chemin": ["@media (min-width: 640px)"],
        "selecteur": ":root",
        "declarations": {
          "--marge-page": "24px"
        }
      },
      {
        "chemin": ["@media (min-width: 1024px)"],
        "selecteur": ":root",
        "declarations": {
          "--marge-page": "32px"
        }
      },
      {
        "chemin": ["@media (pointer: coarse)"],
        "selecteur": ":root",
        "declarations": {
          "--duree-survol": "0ms"
        }
      }

        "chemin": [],
        "selecteur": ":root[data-theme='light']",
        "declarations": {
          "--surface-1": "#faf7f2",
          "--surface-2": "var(--blanc)",
          "--surface-3": "var(--blanc)",
          "--surface-chaude": "#f4efe7",
          "--bordure": "#e7e0d6",
          "--bordure-forte": "#d5ccbe",

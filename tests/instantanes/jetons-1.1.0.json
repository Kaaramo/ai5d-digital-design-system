          "--texte-faible": "#616f78",
          "--reussite": "#0e7c5a",
          "--reussite-fond": "#e6f4ee",
          "--attention": "#b45309",
          "--attention-fond": "#fdf2e3",
          "--erreur": "#b42318",
          "--erreur-fond": "#fdecea",
          "--erreur-survol": "#9a1e14",
